PORT=5000
NODE_ENV=production
MONGO_URI=
# Copy this file to .env. Generate a unique secret with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
CLIENT_URL=https://stay-nest-eight.vercel.app
FRONTEND_URL=https://stay-nest-eight.vercel.app
CORS_ALLOWED_ORIGINS=https://stay-nest-eight.vercel.app,http://localhost:5173,http://localhost:3000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Recommended for Render: Resend HTTPS API (port 443). Verify the sender domain in Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Optional SMTP fallback: set EMAIL_PROVIDER=smtp and configure a provider-supported
# submission port (465 for implicit TLS, 587/2525 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# EMAIL_HOST, EMAIL_PORT, EMAIL_USER, and EMAIL_PASS are accepted as legacy aliases.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
GOOGLE_CALLBACK_URL=https://staynest-1-ihrf.onrender.com/api/auth/google/callback
ADMIN_SIGNUP_EMAILS=admin@gmail.com
